{
  "name": "twofa-twilio-backend",
  "version": "1.0.0",
  "description": "2FA and Twilio SMS Demo Backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migration:run": "node --import tsx ./node_modules/typeorm/cli.js migration:run -d src/config/database.ts",
    "migration:revert": "node --import tsx ./node_modules/typeorm/cli.js migration:revert -d src/config/database.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "tsx": "^4.23.13",
    "typeorm-ts-node-esm": "^0.3.20",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "speakeasy": "^2.0.0",
    "twilio": "^6.1.1",
    "typeorm": "^1.1.1"
  }
}
